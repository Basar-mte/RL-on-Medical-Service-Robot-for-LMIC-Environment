<?xml version="1.0"?>
<sdf version="1.7">
  <world name="hospital">
    <!-- default step (1ms, 1000 Hz) is needlessly expensive for this simple
         scene — 10ms/100Hz matches classic Gazebo's default and cuts physics
         CPU load roughly 10x with no visible difference for this robot. -->
    <physics type="dart"><max_step_size>0.01</max_step_size><real_time_update_rate>100</real_time_update_rate></physics>
    <!-- ROS 2 Humble's official Gazebo pairing is "Fortress" (Ignition Gazebo 6),
         which uses the pre-rebrand ignition-gazebo-* plugin names, not the
         newer gz-sim-* naming from later Gazebo releases. -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><direction>-0.3 -0.3 -1</direction></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient></material></visual></link>
      <pose>20.0 15.0 0 0 0 0</pose></model>
    <model name="zone_ward"><static>true</static>
      <pose>20.000 23.500 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>40.000 13.000 0.02</size></box></geometry>
        <material><ambient>0.3 0.5 0.9 0.4</ambient><diffuse>0.3 0.5 0.9 0.4</diffuse></material></visual></link>
    </model>
    <model name="obs_0"><static>true</static>
      <pose>9.000 17.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>18.000 0.200 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>18.000 0.200 2.000</size></box></geometry>
        <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual></link>
    </model>
    <model name="obs_1"><static>true</static>
      <pose>30.000 17.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>20.000 0.200 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>20.000 0.200 2.000</size></box></geometry>
        <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual></link>
    </model>
    <model name="obs_2"><static>true</static>
      <pose>19.100 21.250 0.300 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.200 2.500 0.600</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2.200 2.500 0.600</size></box></geometry>
        <material><ambient>0.8 0.7 0.4 1</ambient><diffuse>0.8 0.7 0.4 1</diffuse></material></visual></link>
    </model>
    <model name="wall_s"><static>true</static>
      <pose>20.000 0.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>40.000 0.200 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>40.000 0.200 2.000</size></box></geometry>
        <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
    <model name="wall_n"><static>true</static>
      <pose>20.000 30.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>40.000 0.200 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>40.000 0.200 2.000</size></box></geometry>
        <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
    <model name="wall_w"><static>true</static>
      <pose>0.000 15.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.200 30.000 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.200 30.000 2.000</size></box></geometry>
        <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
    <model name="wall_e"><static>true</static>
      <pose>40.000 15.000 1.000 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.200 30.000 2.000</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.200 30.000 2.000</size></box></geometry>
        <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
